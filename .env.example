# === Scrobble vault config ===
# Last.fm configuration (required)
LAST_FM_USERNAME='your_last_fm_username' # your last.fm username
LAST_FM_PASSWORD='your_last_fm_password' # your last.fm password
LAST_FM_API_KEY='your_last_fm_api_key' # your last.fm API key
LAST_FM_API_SECRET='your_last_fm_api_secret' # your last.fm API secret

# Scrobble vault configuration
SYNC_INTERVAL_MINUTES='15' # interval in minutes for syncing scrobbles
RATE_LIMIT_MS='200' # rate limit in milliseconds between API requests
SCROBBLE_VAULT_PORT='8000' # port number of your scrobble vault backend

# Scrobble vault PostgreSQL configuration
POSTGRES_SUPER_USER='admin' # default superuser username for the DB
POSTGRES_SUPER_USER_PASSWORD='mypassword' # default superuser password for the DB
POSTGRES_READ_ONLY_USER='readonly' # read only username for the DB
POSTGRES_READ_ONLY_USER_PASSWORD='mypassword' # read only user password for the DB
POSTGRES_HOST='localhost' # PostgreSQL host, need to change to db eventually for docker
POSTGRES_PORT='5432' # PostgreSQL port
POSTGRES_DB='scrobble_vault' # PostgreSQL database name
POSTGRES_MIN_POOL_SIZE='1' # PostgreSQL min simutanious connections
POSTGRES_MAX_POOL_SIZE='5' # PostgreSQL max simutanious connections

# === frontend config===
SCROBBLE_VAULT_IPV4='127.0.0.1' # ip address of scrobble vault backend from THIS machine: 127.0.0.1 if local, the VPS wireguard IP if remote

# === docker compose config ===
COMPOSE_PROFILES=scrobble_vault,frontend # profiles a bare `docker compose up` starts; `--profile <name>` overrides this to run a subset
POSTGRES_BIND_IP='127.0.0.1' # host interface the DB port binds to; keep localhost unless another machine needs direct DB access
SCROBBLE_VAULT_BIND_IP='127.0.0.1' # host interface the vault API binds to; set to a trusted interface (e.g. VPN) to serve other machines, never a public one (no auth)
FRONTEND_PORT='3000' # port the dockerised frontend serves on
FRONTEND_DEV_PORT='5173' # port the vite dev server uses (docker-compose.dev.yaml)