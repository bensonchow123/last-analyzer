# Values marked [settings page] are only a starting point: once you change one in
# the frontend's settings page the service stores its own copy and that copy wins,
# including after a restart. Everything else is read once at startup, so it only
# changes by editing this file and recreating the container.

# === settings api ===
ADMIN_API_TOKEN='' # bearer token guarding /settings on each service, leave empty to keep those endpoints off

# === Scrobble vault config ===
# Last.fm configuration (required)
LAST_FM_USERNAME='your_last_fm_username' # your last.fm username
LAST_FM_PASSWORD='your_last_fm_password' # your last.fm password
LAST_FM_API_KEY='your_last_fm_api_key' # your last.fm API key [settings page]
LAST_FM_API_SECRET='your_last_fm_api_secret' # your last.fm API secret [settings page]

# Scrobble vault configuration
SYNC_INTERVAL_MINUTES='15' # interval in minutes for syncing scrobbles, any value works including daily (1440) [settings page]
RATE_LIMIT_MS='200' # rate limit in milliseconds between API requests [settings page]
SCROBBLE_VAULT_PORT='8000' # port number of your scrobble vault backend
LLM_ENDPOINTS_ENABLED='true' # serve /vibed-sql-runner and /semantic-search, only needed when a last LLM service uses this vault [settings page]

# Scrobble vault PostgreSQL configuration
POSTGRES_SUPER_USER='admin' # default superuser username for the DB
POSTGRES_SUPER_USER_PASSWORD='mypassword' # default superuser password for the DB
POSTGRES_READ_ONLY_USER='readonly' # read only username for the DB
POSTGRES_READ_ONLY_USER_PASSWORD='mypassword' # read only user password for the DB
POSTGRES_HOST='localhost' # PostgreSQL host, need to change to db eventually for docker
POSTGRES_PORT='5432' # PostgreSQL port
POSTGRES_DB='scrobble_vault' # PostgreSQL database name
POSTGRES_MIN_POOL_SIZE='1' # PostgreSQL min simutanious connections
POSTGRES_MAX_POOL_SIZE='5' # PostgreSQL max simutanious connections

# === frontend config===
SCROBBLE_VAULT_IPV4='127.0.0.1' # ip address of scrobble vault backend from THIS machine: 127.0.0.1 if local, the VPS wireguard IP if remote
LAST_LLM_API_IPV4='127.0.0.1' # ip address of the chat api from THIS machine, same meaning as SCROBBLE_VAULT_IPV4

# === last LLM service config ===
SCROBBLE_VAULT_URL='http://localhost:8000' # base url of the vault from THIS machine; inside docker it is overridden to http://scrobble_vault:8000 automatically
OPENAI_API_KEY='your_api_key' # key for any OpenAI compatible endpoint, a local model server accepts a dummy value [settings page]
OPENAI_BASE_URL='https://api.openai.com/v1' # OpenAI compatible endpoint, e.g. http://localhost:11434/v1 for ollama [settings page]
OPENAI_MODEL='your_model_name' # model the chat api and terminal repl use for tool calling [settings page]
LAST_LLM_MCP_PORT='8001' # port the mcp server serves streamable http on (endpoint /mcp)
LAST_LLM_API_PORT='8002' # port the chat api serves on
MAX_TOOL_ROUNDS='20' # max llm tool calls per question before the agent gives up [settings page]

# === docker compose config ===
COMPOSE_PROFILES=scrobble_vault,frontend,mcp,chat # profiles a bare `docker compose up` starts; `--profile <name>` overrides this to run a subset
POSTGRES_BIND_IP='127.0.0.1' # host interface the DB port binds to; keep localhost unless another machine needs direct DB access
SCROBBLE_VAULT_BIND_IP='127.0.0.1' # host interface the vault API binds to; set to a trusted interface (e.g. VPN) to serve other machines, never a public one (no auth)
LAST_LLM_MCP_BIND_IP='127.0.0.1' # host interface the mcp port binds to; same rules as the vault, no auth so never a public one
LAST_LLM_API_BIND_IP='127.0.0.1' # host interface the chat api binds to; same rules as the vault
FRONTEND_PORT='3000' # port the dockerised frontend serves on
FRONTEND_DEV_PORT='5173' # port the vite dev server uses (docker-compose.dev.yaml)
# SCROBBLE_VAULT_URL_DOCKER='' # only when the vault runs on another machine: its url as seen from inside docker (e.g. a VPN address), replaces the http://scrobble_vault:8000 default
# SETTINGS_FILE='' # where a service keeps its settings page overrides, docker sets this to /data/settings.json on a volume, native runs default to ./settings/
