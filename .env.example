# You only need this file to run the stack across two machines.
#
# On one machine `docker compose --profile full up -d` works with no .env, and
# your last.fm details and model go on the settings page in the frontend.
# Everything below already has a working default, so only uncomment what you
# actually need to change. After editing, run:
#   docker compose up -d --force-recreate

# === which machine runs what ===
# COMPOSE_PROFILES=full # 'full' is everything. Split it per machine, e.g. 'scrobble_vault' on the server and 'chat' on the laptop. A --profile flag overrides this

# === addresses (the reason this file exists) ===
# Nothing can guess these, they are the one thing with no sensible default.
# SCROBBLE_VAULT_IPV4='127.0.0.1' # where the frontend finds the vault, as seen from the frontend's machine. The server's VPN address when it is remote
# LAST_LLM_API_IPV4='127.0.0.1' # same idea for the chat api
# SCROBBLE_VAULT_URL_DOCKER='' # only when the vault is on another machine: its url as seen from inside docker, replaces http://scrobble_vault:8000

# === letting other machines in ===
# Ports bind to 127.0.0.1 by default, so nothing outside the machine can reach them.
# Point one at a VPN address to open it up, and set the token when you do.
# ADMIN_API_TOKEN='' # guards /settings on every service. Use the same value on every machine
# SCROBBLE_VAULT_BIND_IP='127.0.0.1' # never a public interface
# LAST_LLM_API_BIND_IP='127.0.0.1'
# LAST_LLM_MCP_BIND_IP='127.0.0.1'
# POSTGRES_BIND_IP='127.0.0.1' # only for connecting with psql from another machine

# === your own database passwords ===
# Compose defaults these. Change them if you ever set POSTGRES_BIND_IP above,
# since the defaults are the same on every install.
# POSTGRES_SUPER_USER_PASSWORD='scrobble_vault_admin'
# POSTGRES_READ_ONLY_USER_PASSWORD='scrobble_vault_readonly'

# === the embedding model ===
# The vault loads an 87MB model the first time it embeds something, worth
# turning off on a small machine. Sync keeps running, new rows just get no
# vector and /semantic-search 404s. Restart to apply, not on the settings page.
# EMBEDDINGS_ENABLED='true'

# === ports, if something else already uses them ===
# SCROBBLE_VAULT_PORT='8000'
# LAST_LLM_MCP_PORT='8001'
# LAST_LLM_API_PORT='8002'
# FRONTEND_PORT='3000'
# FRONTEND_DEV_PORT='5173' # vite dev server, docker-compose.dev.yaml only
# POSTGRES_PORT='5432'

# === running the code natively, no docker ===
# Only needed if you run `python -m scrobble_vault.main` yourself. Inside docker
# the vault reaches the db by service name, natively it cannot.
# POSTGRES_HOST='localhost'
# POSTGRES_SUPER_USER='admin'
# POSTGRES_READ_ONLY_USER='readonly'
# POSTGRES_DB='scrobble_vault'
# POSTGRES_MIN_POOL_SIZE='1'
# POSTGRES_MAX_POOL_SIZE='5'
# SCROBBLE_VAULT_URL='http://localhost:8000' # where the llm service finds the vault when not in docker
# SETTINGS_FILE='' # where a service keeps its settings page overrides, defaults to ./settings/, docker puts it on a volume

# === seeds for the settings page ===
# Set these on the settings page instead. Values here are only used until the
# first time you change them there, after which the saved copy wins.
# LAST_FM_USERNAME=''
# LAST_FM_API_KEY=''
# SYNC_INTERVAL_MINUTES='15'
# RATE_LIMIT_MS='200'
# LLM_ENDPOINTS_ENABLED='true'
# OPENAI_API_KEY=''
# OPENAI_BASE_URL='https://api.openai.com/v1'
# OPENAI_MODEL=''
# MAX_TOOL_ROUNDS='20'
